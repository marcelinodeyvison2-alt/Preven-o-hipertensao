# Copy this file to .env and fill in your own keys.
# None of these are secret in the sense of server secrets - they are safe to
# ship inside a mobile app bundle, but keep your own .env out of git anyway.

# --- Jamendo (free, royalty-free music catalog) ---
# Get a free client_id at https://devportal.jamendo.com/
EXPO_PUBLIC_JAMENDO_CLIENT_ID=

# --- Firebase (Authentication) ---
# Create a project at https://console.firebase.google.com/, add a Web app,
# and copy the config values below. Enable Email/Password and Google sign-in
# methods under Authentication > Sign-in method.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Google Sign-In OAuth client IDs (from Google Cloud Console / Firebase) ---
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
